{
  "name": "@1mlightyears/dsh-theme-synthwave",
  "version": "0.1.0",
  "description": "DSH Synthwave theme plugin: neon glow hover/focus, translucent panels over image/video background, configurable blur, fontScale root font-size.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "config.dsh-theme-synthwave.example.jsonc",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "synthwave",
    "background",
    "video"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2"
  }
}
